{
  "name": "gitbot-companion",
  "version": "1.0.0",
  "description": "Ultra-lightweight GitHub Automation & Sync Discord Bot and Local Companion Daemon",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "deploy-commands": "tsx src/discord/deploy-commands.ts",
    "autostart:install": "node scripts/autostart.js --install",
    "autostart:uninstall": "node scripts/autostart.js --uninstall",
    "autostart:status": "node scripts/autostart.js --status",
    "start:silent": "wscript //B scripts/run-silent.vbs",
    "cf:watch": "node scripts/cf-wakekeeper.js"
  },
  "keywords": [
    "discord-bot",
    "components-v2",
    "github",
    "git-sync",
    "git-track",
    "git-autoget",
    "daemon"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
